# Gemini AI: free key at https://aistudio.google.com/apikey (starts with "AIza", 39 characters)
GEMINI_API_KEY=
# Optional: model (default gemini-3.5-flash; falls back to gemini-3.8-flash, then gemini-3.5-flash-lite)
# GEMINI_MODEL=gemini-3.5-flash

# PayPal sandbox app (https://developer.paypal.com/dashboard/applications/sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
# Optional: webhook id from the same app (INVOICING.INVOICE.PAID etc.), for /api/paypal/webhook
PAYPAL_WEBHOOK_ID=


# Public URL of the app (used for PayPal return URLs). Defaults to the request origin.
# APP_URL=https://leash.onrender.com

# Signs the session cookie. Generate with: openssl rand -hex 32
SESSION_SECRET=
# Where the SQLite database lives (default ./data). On Render, point this at the persistent disk.
# LEASH_DATA_DIR=/var/data
