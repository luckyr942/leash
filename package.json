{
  "name": "leash",
  "version": "0.1.0",
  "private": true,
  "description": "Leash: paste a client chat, approve the invoice, PayPal sends it, and AI drafts every follow-up you approve with one tap.",
  "license": "MIT",
  "scripts": {
    "dev": "env -u GEMINI_API_KEY -u GOOGLE_API_KEY NODE_OPTIONS=--disable-warning=ExperimentalWarning next dev",
    "build": "NODE_OPTIONS=--disable-warning=ExperimentalWarning next build",
    "start": "NODE_OPTIONS=--disable-warning=ExperimentalWarning next start -p ${PORT:-3000}",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "@google/genai": "^3.0.0",
    "@paypal/agent-toolkit": "^1.11.0",
    "ag-grid-community": "^36.3.0",
    "ag-grid-react": "^36.3.0",
    "imapflow": "^2.10.2",
    "mailparser": "^3.14.2",
    "next": "^16.4.5",
    "nodemailer": "^10.3.1",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/mailparser": "^3.9.0",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "5.9"
  }
}
